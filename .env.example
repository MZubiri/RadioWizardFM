# WizardFM — Environment Variables
# Copy to .env and configure, or set in Coolify dashboard

# AzuraCast Configuration
AZURACAST_API_URL=https://radio.wizardfm.lat
STREAM_URL=https://radio.wizardfm.lat/radio
STATION_ID=1

# Ports (Coolify will map these)
FRONTEND_PORT=3000
CHAT_PORT=3001

# Chat Server
MAX_HISTORY=100
RATE_LIMIT_MS=1000
MAX_MESSAGE_LENGTH=500
