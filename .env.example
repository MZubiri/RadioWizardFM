# WizardFM — Environment Variables
# Copy to .env and configure, or set in Coolify dashboard

# AzuraCast Configuration
AZURACAST_API_URL=https://panel.wizardfm.lat
STREAM_URL=https://panel.wizardfm.lat/listen/wizardfm/radio.mp3
STATION_ID=wizardfm

# Ports (Coolify will map these)
FRONTEND_PORT=3000
CHAT_PORT=3001

# Chat Server
MAX_HISTORY=100
RATE_LIMIT_MS=1000
MAX_MESSAGE_LENGTH=500
